rules_version = '2';

// Security rules for the Prayer Box database. Paste these into
// Firebase console > Firestore Database > Rules, then Publish.
//
// Anyone can read prayers and replies. Only signed-in people can post, and posts are
// checked for size and shape. No account id is stored on a post, so anonymous posts stay
// anonymous. Who wrote what lives in each person's private area (users/{uid}/...), which
// only they can read: that's what powers "My prayers", and it's what lets the author, and
// only the author, edit or delete their own prayers and replies.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 40;
    }

    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function validPrayer(data) {
      return validName(data)
        && validText(data.request, 2000)
        && data.visibility in ['anonymous', 'public']
        && (data.visibility == 'public' || data.name == 'Anonymous');
    }

    function validReply(data) {
      return validName(data) && validText(data.text, 1000);
    }

    function ownsPrayer(prayerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/prayers/$(prayerId));
    }

    function ownsReply(prayerId, replyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/replies/$(prayerId + '_' + replyId));
    }

    match /prayers/{prayerId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'request', 'visibility', 'createdAt'])
        && validPrayer(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if ownsPrayer(prayerId)
        && request.resource.data.keys().hasOnly(['name', 'request', 'visibility', 'createdAt', 'editedAt'])
        && validPrayer(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.editedAt == request.time;

      allow delete: if ownsPrayer(prayerId);

      match /replies/{replyId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
          && validReply(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if ownsReply(prayerId, replyId)
          && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt', 'editedAt'])
          && validReply(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.editedAt == request.time;

        // A prayer's author can also clear its replies when deleting the prayer.
        allow delete: if ownsReply(prayerId, replyId) || ownsPrayer(prayerId);
      }
    }

    // ---- Each person's private area ------------------------------------------------------

    // "My prayers": one entry per prayer they dropped (the document id is the prayer's id),
    // with answered / seen-replies state for the dashboard.
    function validAnswerState(data) {
      return data.answered is bool
        && (data.answered == true
          ? data.answeredAt == request.time
          : !('answeredAt' in data))
        && (!('answerNote' in data)
          || (data.answerNote is string && data.answerNote.size() <= 280));
    }

    match /users/{uid}/prayers/{prayerId} {
      allow read: if signedIn() && request.auth.uid == uid;

      // Only written together with the prayer itself, so nobody can claim someone else's.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt', 'answered', 'seenReplies'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.answered == false
        && request.resource.data.seenReplies == 0
        && !exists(/databases/$(database)/documents/prayers/$(prayerId))
        && existsAfter(/databases/$(database)/documents/prayers/$(prayerId));

      // Two kinds of change: marking replies as read, or marking answered / waiting.
      allow update: if signedIn() && request.auth.uid == uid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenReplies'])
            && request.resource.data.seenReplies is int
            && request.resource.data.seenReplies >= 0)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answered', 'answeredAt', 'answerNote'])
            && validAnswerState(request.resource.data))
        );

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // "My replies": one entry per reply they wrote, keyed "<prayerId>_<replyId>".
    match /users/{uid}/replies/{key} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prayerId', 'replyId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && key == request.resource.data.prayerId + '_' + request.resource.data.replyId
        && !exists(/databases/$(database)/documents/prayers/$(request.resource.data.prayerId)/replies/$(request.resource.data.replyId))
        && existsAfter(/databases/$(database)/documents/prayers/$(request.resource.data.prayerId)/replies/$(request.resource.data.replyId));

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Email updates -------------------------------------------------------------------

    // Each person's email choices (both off unless they turn them on). Only they can read
    // or change them; the email server reads them with admin access.
    match /emailPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['replies', 'digest', 'updatedAt'])
        && request.resource.data.replies is bool
        && request.resource.data.digest is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Who to email when a prayer gets a reply. Written together with the prayer, and
    // nobody can read it from the site: only the email server can, with admin access.
    // This keeps anonymous prayers anonymous.
    match /owners/{prayerId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/prayers/$(prayerId))
        && existsAfter(/databases/$(database)/documents/prayers/$(prayerId));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Bookkeeping that only the email server touches (admin access skips these rules).
    match /emailState/{doc=**} {
      allow read, write: if false;
    }
  }
}

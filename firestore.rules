rules_version = '2';

// Security rules for the Prayer Box database. Paste these into
// Firebase console > Firestore Database > Rules, then Publish.
//
// Anyone can read prayers and replies. Only signed-in people can post, posts are
// checked for size and shape, and prayers and replies can't be edited or deleted.
// No account id is stored on a post, so anonymous posts stay anonymous. The only
// editable data is each person's own private "My prayers" list (see the bottom).
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 40;
    }

    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /prayers/{prayerId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'request', 'visibility', 'createdAt'])
        && validName(request.resource.data)
        && validText(request.resource.data.request, 2000)
        && request.resource.data.visibility in ['anonymous', 'public']
        && (request.resource.data.visibility == 'public' || request.resource.data.name == 'Anonymous')
        && request.resource.data.createdAt == request.time;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
          && validName(request.resource.data)
          && validText(request.resource.data.text, 1000)
          && request.resource.data.createdAt == request.time;
      }
    }

    // "My prayers" dashboard. Each signed-in person gets a private list that points at the
    // prayers they dropped (the document id is the prayer's id). Only that person can read
    // or change it, so a prayer posted anonymously can't be traced back to an account.
    function validAnswerState(data) {
      return data.answered is bool
        && (data.answered == true
          ? data.answeredAt == request.time
          : !('answeredAt' in data))
        && (!('answerNote' in data)
          || (data.answerNote is string && data.answerNote.size() <= 280));
    }

    match /users/{uid}/prayers/{prayerId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt', 'answered', 'seenReplies'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.answered == false
        && request.resource.data.seenReplies == 0;

      // Two kinds of change: marking replies as read, or marking answered / waiting.
      allow update: if request.auth != null && request.auth.uid == uid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenReplies'])
            && request.resource.data.seenReplies is int
            && request.resource.data.seenReplies >= 0)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answered', 'answeredAt', 'answerNote'])
            && validAnswerState(request.resource.data))
        );
    }
  }
}

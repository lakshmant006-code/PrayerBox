rules_version = '2';

// Security rules for the Prayer Box database. Paste these into
// Firebase console > Firestore Database > Rules, then Publish.
//
// Anyone can read prayers and replies. Only signed-in people can post, posts are
// checked for size and shape, and nothing can be edited or deleted from the site.
// No account id is stored on a post, so anonymous posts stay anonymous.
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 40;
    }

    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /prayers/{prayerId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'request', 'visibility', 'createdAt'])
        && validName(request.resource.data)
        && validText(request.resource.data.request, 2000)
        && request.resource.data.visibility in ['anonymous', 'public']
        && (request.resource.data.visibility == 'public' || request.resource.data.name == 'Anonymous')
        && request.resource.data.createdAt == request.time;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
          && validName(request.resource.data)
          && validText(request.resource.data.text, 1000)
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
